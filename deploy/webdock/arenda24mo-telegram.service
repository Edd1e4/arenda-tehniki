[Unit]
Description=Arenda24 MO Telegram personal pilot
Wants=network-online.target
After=network-online.target arenda24mo-dispatcher.service
Requires=arenda24mo-dispatcher.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=arenda24mo
Group=arenda24mo
WorkingDirectory=/opt/arenda24mo/app
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
KillSignal=SIGINT
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ReadWritePaths=/var/lib/arenda24mo
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
StandardOutput=journal
StandardError=journal
EnvironmentFile=/etc/arenda24mo/telegram.env
ExecStart=/usr/bin/node /opt/arenda24mo/app/telegram.mjs

[Install]
WantedBy=multi-user.target
